# AI Expense Tracker environment configuration example
# Copy this file to .env for local development and replace example values.
# Never commit real credentials or production secrets to version control.

MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/expense_tracker?retryWrites=true&w=majority
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ACCESS_TOKEN_EXPIRES=86400

# Smart AI-Based Receipt Scanner
# Maximum request/upload size in bytes (default: 10 MB)
RECEIPT_MAX_BYTES=10485760

# Comma-separated supported receipt file extensions
RECEIPT_ALLOWED_EXTENSIONS=png,jpg,jpeg,webp,bmp,tif,tiff,pdf

# OCR language(s); requires matching Tesseract language data to be installed
# Examples: eng or eng+hin
RECEIPT_OCR_LANGUAGE=eng

# Optional absolute path to the Tesseract executable.
# Leave blank when Tesseract is available on the system PATH.
TESSERACT_CMD=